<mxfile host="neurostack"><diagram name="Overview"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="How NeuroStack works" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="800" height="34" as="geometry" /></mxCell><mxCell id="c3" value="A local retrieval layer and optimizer for a Markdown knowledge base. Top row: notes in, ranked evidence out. Bottom band: what keeps the base accurate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="900" height="30" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font color=&quot;#0B5CAD&quot;&gt;📁 Markdown knowledge base&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Obsidian, Logseq, Notion export, any .md folder&lt;br&gt;• Read-only: indexing never edits files&lt;br&gt;• Optional: git repo for write-back" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="150" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font color=&quot;#6941C6&quot;&gt;🗄 Index&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• SQLite + FTS5 keyword index&lt;br&gt;• Embeddings and chunk vectors (Ollama, local)&lt;br&gt;• Wiki-link graph, PageRank, summaries, triples" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#6941C6;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="300" height="150" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font color=&quot;#147D45&quot;&gt;🔌 Serve&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Hybrid search, tiered by token budget&lt;br&gt;• Ranked evidence with note paths and excerpts&lt;br&gt;• Agent memories and session context" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#147D45;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="280" height="150" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font color=&quot;#263247&quot;&gt;🤖 AI clients&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Claude Code, Claude Desktop, Cursor&lt;br&gt;• Windsurf, Gemini CLI, VS Code, Codex&lt;br&gt;• Any MCP client, or the CLI / HTTP API" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#263247;" vertex="1" parent="1"><mxGeometry x="1270" y="110" width="230" height="150" as="geometry" /></mxCell><mxCell id="c8" value="neurostack&lt;br&gt;index / watch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-14" /></mxGeometry></mxCell><mxCell id="c9" value="ranked results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-14" /></mxGeometry></mxCell><mxCell id="c10" value="MCP · CLI ·&lt;br&gt;OpenAI-compatible API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-24" /></mxGeometry></mxCell><mxCell id="c11" value="prediction errors: a note that surfaces but does not fit is flagged and demoted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#D96500;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="300" /><mxPoint x="580" y="300" /></Array><mxPoint as="offset" y="-14" /></mxGeometry></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#D0D7E2;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1460" height="300" as="geometry" /></mxCell><mxCell id="c14" value="Optimizer" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="370" width="24" height="300" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;&lt;font color=&quot;#0B5CAD&quot;&gt;💬 AI session transcripts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Claude Code, Codex, Gemini CLI, omp&lt;br&gt;• Hourly timer + SessionEnd hook&lt;br&gt;• Posted to the server, never rsynced" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="240" height="140" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;&lt;font color=&quot;#D96500&quot;&gt;🧲 Harvest&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• LLM classifies each message&lt;br&gt;• Keeps decisions, bugs, conventions, learnings&lt;br&gt;• Saves as memories with a TTL per type" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D96500;" vertex="1" parent="1"><mxGeometry x="450" y="410" width="240" height="140" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;&lt;font color=&quot;#D96500&quot;&gt;🔁 Synthesize&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Clusters recurring observations&lt;br&gt;• Writes one learning per cluster&lt;br&gt;• Flags memories that drift from their notes" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D96500;" vertex="1" parent="1"><mxGeometry x="820" y="410" width="240" height="140" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;&lt;font color=&quot;#147D45&quot;&gt;⬆ Promote&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Promotion queue ranks durable memories&lt;br&gt;• Consolidation writes or extends a vault note&lt;br&gt;• Commit + push through your git remote" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#147D45;" vertex="1" parent="1"><mxGeometry x="1190" y="410" width="240" height="140" as="geometry" /></mxCell><mxCell id="c19" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0B5CAD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="68" y="398" width="28" height="28" as="geometry" /></mxCell><mxCell id="c20" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D96500;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="438" y="398" width="28" height="28" as="geometry" /></mxCell><mxCell id="c21" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D96500;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="808" y="398" width="28" height="28" as="geometry" /></mxCell><mxCell id="c22" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147D45;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1178" y="398" width="28" height="28" as="geometry" /></mxCell><mxCell id="c23" value="transcript" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-14" /></mxGeometry></mxCell><mxCell id="c24" value="memories" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-14" /></mxGeometry></mxCell><mxCell id="c25" value="learnings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-14" /></mxGeometry></mxCell><mxCell id="c26" value="new or extended note, committed to git" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#147D45;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c18" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="345" /><mxPoint x="170" y="345" /></Array><mxPoint as="offset" y="-14" /></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Key outcomes&lt;/b&gt;&amp;nbsp;&amp;nbsp; Your AI answers from your own notes with citations &amp;nbsp;·&amp;nbsp; Stale notes are demoted before they get cited &amp;nbsp;·&amp;nbsp; Decisions made in AI sessions end up back in the knowledge base as notes" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#6B7280;align=left;spacing=12;fontSize=12;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="1380" height="50" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp; solid = data flow &amp;nbsp;·&amp;nbsp; dashed amber = stale-detection feedback &amp;nbsp;·&amp;nbsp; dashed green = write-back to the vault (opt-in, git)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="900" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>