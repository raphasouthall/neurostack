/></mxCell><mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#D0D7E2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="410" width="1200" height="150" as="geometry" /></mxCell><mxCell id="c9" value="Store" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#263247;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="465.0" width="150" height="40" as="geometry" /></mxCell><mxCell id="c10" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F5F9;strokeColor=#D0D7E2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="560" width="1200" height="150" as="geometry" /></mxCell><mxCell id="c11" value="Serving" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#147D45;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="615.0" width="150" height="40" as="geometry" /></mxCell><mxCell id="c12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#D0D7E2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="710" width="1200" height="150" as="geometry" /></mxCell><mxCell id="c13" value="Optimizer" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D96500;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="765.0" width="150" height="40" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;&lt;font color=&quot;#0B5CAD&quot;&gt;📁 Markdown vault&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Any folder of .md files&lt;br&gt;• frontmatter, [[wiki-links]]&lt;br&gt;• watcher.py re-indexes on save" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="330" y="130.0" width="220" height="110" as="geometry" /></mxCell><mxCell id="c15" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0B5CAD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318" y="118.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;&lt;font color=&quot;#0B5CAD&quot;&gt;💬 Session transcripts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Claude Code, Codex, Gemini, omp&lt;br&gt;• harvest.py parses each format&lt;br&gt;• redact.py strips secrets first" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="1030" y="130.0" width="240" height="110" as="geometry" /></mxCell><mxCell id="c17" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0B5CAD;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1018" y="118.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;&lt;font color=&quot;#6941C6&quot;&gt;✂ Parse and chunk&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• chunker.py splits by heading&lt;br&gt;• graph.py resolves wiki-links&lt;br&gt;• PageRank over the link graph" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#6941C6;" vertex="1" parent="1"><mxGeometry x="330" y="280.0" width="220" height="110" as="geometry" /></mxCell><mxCell id="c19" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6941C6;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318" y="268.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;&lt;font color=&quot;#6941C6&quot;&gt;🧠 Embed and enrich&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• embedder.py: Ollama, local model&lt;br&gt;• summarizer.py: note and folder summaries&lt;br&gt;• triples.py: subject-predicate-object facts" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#6941C6;" vertex="1" parent="1"><mxGeometry x="680" y="280.0" width="240" height="110" as="geometry" /></mxCell><mxCell id="c21" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6941C6;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="668" y="268.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;&lt;font color=&quot;#263247&quot;&gt;🗄 neurostack.db (SQLite)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• notes, chunks + FTS5, chunk vectors (vecindex.py)&lt;br&gt;• links, triples, communities, note_usage, prediction_errors&lt;br&gt;• memories with TTL, sessions, search_log / feedback" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#263247;" vertex="1" parent="1"><mxGeometry x="330" y="430.0" width="590" height="110" as="geometry" /></mxCell><mxCell id="c23" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#263247;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318" y="418.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;&lt;font color=&quot;#147D45&quot;&gt;⚖ Hybrid ranker (search.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• FTS5 + cosine base score&lt;br&gt;• boosts: context, hotness, co-occurrence&lt;br&gt;• demotes: prediction errors, lateral inhibition" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#147D45;" vertex="1" parent="1"><mxGeometry x="330" y="580.0" width="220" height="110" as="geometry" /></mxCell><mxCell id="c25" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147D45;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318" y="568.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;&lt;font color=&quot;#147D45&quot;&gt;🔌 Tool surface&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• server.py: MCP (stdio / http), 24 tools&lt;br&gt;• api.py: OpenAI-compatible /v1/*&lt;br&gt;• cli: search, tiered, context" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#147D45;" vertex="1" parent="1"><mxGeometry x="680" y="580.0" width="240" height="110" as="geometry" /></mxCell><mxCell id="c27" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147D45;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="668" y="568.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;&lt;font color=&quot;#263247&quot;&gt;🤖 AI client&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Claude Code, Cursor, Codex, ...&lt;br&gt;• vault_search, vault_summary, vault_context&lt;br&gt;• vault_remember, vault_record_usage" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#263247;" vertex="1" parent="1"><mxGeometry x="1030" y="580.0" width="240" height="110" as="geometry" /></mxCell><mxCell id="c29" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#263247;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1018" y="568.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;&lt;font color=&quot;#D96500&quot;&gt;🧲 Harvest (harvest.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• LLM classifies messages in batches of 5&lt;br&gt;• KEEP: bug, decision, convention, learning&lt;br&gt;• memories saved with TTL per type" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D96500;" vertex="1" parent="1"><mxGeometry x="1030" y="730.0" width="240" height="110" as="geometry" /></mxCell><mxCell id="c31" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D96500;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1018" y="718.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;&lt;font color=&quot;#D96500&quot;&gt;🔁 Synthesize (synthesize.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• clusters recurring observations&lt;br&gt;• one learning per cluster&lt;br&gt;• memory_drift.py flags stale memories" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D96500;" vertex="1" parent="1"><mxGeometry x="680" y="730.0" width="240" height="110" as="geometry" /></mxCell><mxCell id="c33" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D96500;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="668" y="718.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;&lt;font color=&quot;#147D45&quot;&gt;⬆ Promote (consolidate.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• promotion.py ranks the queue&lt;br&gt;• writes or extends a vault note&lt;br&gt;• vault_write_file: commit + push" style="rounded=1;arcSize=10;shadow=1;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#147D45;" vertex="1" parent="1"><mxGeometry x="330" y="730.0" width="220" height="110" as="geometry" /></mxCell><mxCell id="c35" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147D45;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318" y="718.0" width="28" height="28" as="geometry" /></mxCell><mxCell id="c36" value="neurostack&lt;br&gt;index / watch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="80" y="0" /></mxGeometry></mxCell><mxCell id="c37" value="chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-24" /></mxGeometry></mxCell><mxCell id="c38" value="notes, chunks, vectors, links, triples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=0.5;exitY=1;entryX=0.797;entryY=0;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="120" y="0" /></mxGeometry></mxCell><mxCell id="c39" value="FTS5 + vector query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=0.112;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-62" y="0" /></mxGeometry></mxCell><mxCell id="c40" value="log prediction_error, note_usage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#D96500;dashed=1;exitX=0.7;exitY=0;entryX=0.261;entryY=1;" edge="1" parent="1" source="c24" target="c22"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="96" y="0" /></mxGeometry></mxCell><mxCell id="c41" value="search(query, context)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=0;exitY=0.35;entryX=1;entryY=0.35;" edge="1" parent="1" source="c26" target="c24"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12" /></mxGeometry></mxCell><mxCell id="c42" value="ranked, tiered results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.65;entryX=0;entryY=0.65;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="12" /></mxGeometry></mxCell><mxCell id="c43" value="MCP · CLI ·&lt;br&gt;OpenAI API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-24" /></mxGeometry></mxCell><mxCell id="c44" value="SessionEnd hook + hourly&lt;br&gt;timer post the transcript" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c28" target="c16"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="88" y="0" /></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c16" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="185.0" /><mxPoint x="1350" y="785.0" /></Array><mxPoint as="offset" x="0" y="-14" /></mxGeometry></mxCell><mxCell id="c46" value="vault_harvest_transcript" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1364" y="325.0" width="20" height="300" as="geometry" /></mxCell><mxCell id="c47" value="memories" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14" /></mxGeometry></mxCell><mxCell id="c48" value="learnings,&lt;br&gt;promotion queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#263247;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-24" /></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;labelBackgroundColor=#FAFBFD;fontSize=11;strokeColor=#147D45;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c34" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="785.0" /><mxPoint x="260" y="185.0" /></Array><mxPoint as="offset" x="0" y="-14" /></mxGeometry></mxCell><mxCell id="c50" value="new note via git commit + push" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#147D45;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="228" y="315.0" width="20" height="320" as="geometry" /></mxCell><mxCell id="c51" value="Ranking signals (search.py)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#263247;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="110" width="300" height="30" as="geometry" /></mxCell><mxCell id="c52" value="Base score: FTS5 BM25 fused with chunk cosine similarity.&lt;br&gt;&lt;br&gt;Boosts, in pipeline order: link_section, convergence, context, hotness, cooccurrence.&lt;br&gt;&lt;br&gt;Demotions: prediction_error (a note surfaced with low overlap or a contextual mismatch, 3+ times, unresolved) and lateral_inhibition.&lt;br&gt;&lt;br&gt;Each signal can be ablated; neurostack eval measures its marginal recall@k / MRR / NDCG." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="150" width="300" height="250" as="geometry" /></mxCell><mxCell id="c53" value="Scheduled jobs" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D96500;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="430" width="300" height="30" as="geometry" /></mxCell><mxCell id="c54" value="Harvest: hourly timer + SessionEnd hook, installed by neurostack init.&lt;br&gt;&lt;br&gt;Decay: daily; excitability and dormancy report.&lt;br&gt;&lt;br&gt;Synthesize: weekly; observations to learnings.&lt;br&gt;&lt;br&gt;Consolidation replay: promotes queued memories into notes, archives them with a promoted: pointer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="470" width="300" height="200" as="geometry" /></mxCell><mxCell id="c55" value="&lt;b&gt;Key outcomes&lt;/b&gt;&amp;nbsp; ranked evidence the caller can cite &amp;nbsp;·&amp;nbsp; stale notes demoted before they are cited &amp;nbsp;·&amp;nbsp; session knowledge returns to the vault as notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#6B7280;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#263247;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="700" width="300" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>